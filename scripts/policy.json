      "quora.com", "x.com", "twitter.com", "linkedin.com",
      "youtube.com", "wikipedia.org", "cnn.com", "bbc.com", "forbes.com",
      "businessinsider.com", "techcrunch.com", "venturebeat.com",
      "zdnet.com", "cnet.com", "engadget.com", "mashable.com",
      "hankyung.com", "mk.co.kr", "chosun.com", "joongang.co.kr",
      "etnews.com", "zdnet.co.kr", "bloter.net"
    ],
    "6": [
      "geeksforgeeks.org", "w3schools.com", "tutorialspoint.com",
      "javatpoint.com", "simplilearn.com", "guru99.com", "edureka.co",
      "analyticsvidhya.com", "kdnuggets.com", "datacamp.com/blog",
      "hackr.io", "codecademy.com/resources", "turing.com/blog",
      "aimultiple.com", "marketsandmarkets.com", "grandviewresearch.com",
      "alliedmarketresearch.com", "mordorintelligence.com",
      "precedenceresearch.com", "fortunebusinessinsights.com",
      "expertbeacon.com", "byjus.com", "unstop.com", "naukri.com",
