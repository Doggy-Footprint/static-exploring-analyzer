    ],
    "block": [
      "sci-hub.se", "libgen.is", "researchgate.net/publication/preview",
      "paperswithcode.com/paper/mirror", "semantic-scholar-mirror.com",
      "arxiv-sanity-lite.com/mirror", "chatgptdetector.co",
      "coursehero.com", "scribd.com", "studocu.com", "slideshare.net",
      "issuu.com", "academia.edu"
    ]
  },

  "notes": [
    "mdpi / frontiers vary a lot per journal: kept at tier 2 but leaning heavily on citation adjustment.",
    "github.com sits at tier 4 and is moved mostly by actual star count.",
    "wikipedia is tier 5; SKILL.md instructs using it only to walk footnotes back to primary sources."
  ]
}
