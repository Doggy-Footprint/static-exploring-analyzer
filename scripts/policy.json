      "ft.com", "economist.com", "wsj.com", "bloomberg.com", "reuters.com",
      "apnews.com", "nytimes.com", "washingtonpost.com", "theguardian.com",
      "semianalysis.com", "stratechery.com", "importai.substack.com",
      "simonwillison.net", "martinfowler.com", "danluu.com",
      "acoup.blog", "astralcodexten.com", "lesswrong.com",
