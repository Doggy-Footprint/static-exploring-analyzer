      "lmsys.org", "eleuther.ai", "allenai.org", "bair.berkeley.edu",
      "thegradient.pub", "jalammar.github.io"
    ],
    "4": [
      "arstechnica.com", "theverge.com", "wired.com", "technologyreview.com",
